{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {SourceContext} {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "Diagnostics": {
    "ErrorFileLogging": {
      "Enabled": true,
      "RootDirectory": "logs",
      "FileNamePrefix": "errors",
      "RestrictedToMinimumLevel": "Error",
      "RetentionDays": 14
    }
  },
  "AllowedHosts": "*",
  "DownstreamServices": {
    "CityCore": "https://localhost:7207",
    "Economy": "http://localhost:5286",
    "Population": "https://localhost:7297",
    "Identity": "https://localhost:7256"
  },
  "PermissionsVersion": {
    "CacheTtlSeconds": 300
  },
  "AuthContext": {
    "CacheTtlSeconds": 300
  },
  "ExternalJwt": {
    "Issuer": "",
    "Audience": "",
    "SigningKey": ""
  },
  "IdentityInternal": {
    "BaseUrl": "",
    "ApiKey": ""
  },
  "Redis": {
    "ConnectionString": "",
    "InstanceName": ""
  },
  "RabbitMq": {
    "Host": "",
    "Port": "",
    "VirtualHost": "",
    "Username": "",
    "Password": ""
  },
  "InternalJwt": {
    "Issuer": "",
    "Audience": "",
    "SigningKey": "",
    "LifetimeSeconds": ""
  }
}
