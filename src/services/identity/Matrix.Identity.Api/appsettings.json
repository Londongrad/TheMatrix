{
  "AllowedHosts": "*",
  "PostgresResilience": {
    "MaxRetryCount": 5,
    "MaxRetryDelaySeconds": 10
  },
  "GeoLocation": {
    "Enabled": false,
    "TimeoutSeconds": 10,
    "EndpointTemplate": "https://ipapi.co/{ip}/json/"
  },
  "FrontendLinks": {
    "BaseUrl": "http://localhost:5173",
    "ConfirmEmailPath": "/confirm-email",
    "ConfirmEmailChangePath": "/confirm-email-change",
    "ResetPasswordPath": "/reset-password",
    "ConfirmAccountRecoveryPath": "/confirm-account-recovery"
  },
  "Email": {
    "DeliveryMode": "LogOnly",
    "FromEmail": "noreply@example.com",
    "FromName": "The Matrix",
    "SmtpHost": "",
    "SmtpPort": 587,
    "SmtpUsername": "",
    "SmtpPassword": "",
    "UseSsl": true
  },
  "OneTimeTokens": {
    "EmailConfirmationLifetimeMinutes": 1440,
    "EmailConfirmationCooldownSeconds": 60,
    "EmailConfirmationMaxDeliveryAttemptsPerHour": 5,
    "EmailChangeLifetimeMinutes": 1440,
    "EmailChangeCooldownSeconds": 60,
    "EmailChangeMaxDeliveryAttemptsPerHour": 5,
    "PasswordResetLifetimeMinutes": 60,
    "PasswordResetCooldownSeconds": 60,
    "PasswordResetMaxDeliveryAttemptsPerHour": 5,
    "AccountRecoveryLifetimeMinutes": 120,
    "AccountRecoveryCooldownSeconds": 60,
    "AccountRecoveryMaxDeliveryAttemptsPerHour": 5
  },
  "SecurityAudit": {
    "FailedLoginWindowMinutes": 15,
    "FailedLoginMaxAttemptsPerLogin": 10,
    "FailedLoginMaxAttemptsPerIp": 20,
    "EmailConfirmationRequestWindowMinutes": 60,
    "EmailConfirmationRequestMaxAttemptsPerEmail": 5,
    "EmailConfirmationRequestMaxAttemptsPerIp": 20,
    "EmailChangeRequestWindowMinutes": 60,
    "EmailChangeRequestMaxAttemptsPerEmail": 5,
    "EmailChangeRequestMaxAttemptsPerIp": 20,
    "PasswordResetRequestWindowMinutes": 60,
    "PasswordResetRequestMaxAttemptsPerEmail": 5,
    "PasswordResetRequestMaxAttemptsPerIp": 20,
    "AccountRecoveryRequestWindowMinutes": 60,
    "AccountRecoveryRequestMaxAttemptsPerEmail": 5,
    "AccountRecoveryRequestMaxAttemptsPerIp": 20
  },
  "SecurityAuditCleanup": {
    "CleanupEnabled": true,
    "PollIntervalSeconds": 3600,
    "BatchSize": 1000,
    "RetentionDays": 30
  },
  "Outbox": {
    "BatchSize": 50,
    "PollIntervalSeconds": 2,
    "LeaseTtlSeconds": 30,
    "FailureBackoffMaxSeconds": 300,
    "ProcessedRetentionSeconds": 0,
    "CleanupBatchSize": 500
  },
  "RefreshTokenCleanup": {
    "CleanupEnabled": true,
    "PollIntervalSeconds": 300,
    "BatchSize": 500,
    "RevokedRetentionHours": 24,
    "ExpiredRetentionHours": 24
  },
  "ExternalJwt": {
    "Issuer": "",
    "Audience": "",
    "SigningKey": "",
    "AccessTokenLifetimeMinutes": "",
    "RefreshTokenLifetimeDays": "",
    "ShortRefreshTokenLifetimeHours": ""
  },
  "IdentityInternal": {
    "ApiKey": ""
  },
  "ConnectionStrings": {
    "IdentityDb": ""
  },
  "HealthChecks": {
    "RabbitMq": {
      "Enabled": true,
      "TimeoutSeconds": 3
    }
  },
  "RabbitMq": {
    "Host": "",
    "Port": "",
    "VirtualHost": "",
    "Username": "",
    "Password": "",
    "EndpointHygiene": {
      "DiscardSkippedMessages": true
    }
  }
}
