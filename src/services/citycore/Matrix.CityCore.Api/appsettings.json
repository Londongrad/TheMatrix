{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Warning",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {SourceContext} {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "Diagnostics": {
    "ErrorFileLogging": {
      "Enabled": true,
      "RootDirectory": "logs",
      "FileNamePrefix": "errors",
      "RestrictedToMinimumLevel": "Error",
      "RetentionDays": 14
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "CityCoreDb": ""
  },
  "InternalJwt": {
    "Issuer": "",
    "Audience": "",
    "SigningKey": ""
  },
  "RabbitMq": {
    "Host": "",
    "Port": "",
    "VirtualHost": "",
    "Username": "",
    "Password": ""
  },
  "Outbox": {
    "BatchSize": 50,
    "PollIntervalSeconds": 2,
    "LeaseTtlSeconds": 30,
    "FailureBackoffMaxSeconds": 300,
    "ProcessedRetentionSeconds": 0,
    "CleanupBatchSize": 500
  },
  "CityCore": {
    "Tick": {
      "PeriodMilliseconds": 1000
    }
  }
}
