{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {SourceContext} {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "Diagnostics": {
    "ErrorFileLogging": {
      "Enabled": true,
      "RootDirectory": "logs",
      "FileNamePrefix": "errors",
      "RestrictedToMinimumLevel": "Error",
      "RetentionDays": 14
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "EconomyDb": ""
  },
  "InternalJwt": {
    "Issuer": "",
    "Audience": "",
    "SigningKey": ""
  }
}
